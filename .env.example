# TerraLens Configuration

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# PostgreSQL / PostGIS Database
DATABASE_URL=postgresql://localhost:5432/terralens
DATABASE_ASYNC_URL=postgresql+asyncpg://localhost:5432/terralens

# AI Agent Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Geospatial & Analysis Thresholds
DEFAULT_CLOUD_COVER_THRESHOLD=20.0
DEFAULT_NDVI_CHANGE_THRESHOLD=-0.20
MIN_CHANGE_AREA_M2=500.0
SPATIAL_SEARCH_RADIUS_METERS=1000.0
